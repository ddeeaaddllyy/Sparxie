# ─── nedovolen-auth: пример конфигурации ────────────────────────────────────
# Скопируйте в `.env` и при необходимости отредактируйте:
#   cp .env.example .env

# ── HTTP-сервер ──────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
REQUEST_TIMEOUT_SECS=15

# ── PostgreSQL (общая база аккаунтов) ────────────────────────────────────────
DATABASE_URL=postgres://nedovolen:nedovolen@localhost:5432/nedovolen

# ── Redis (refresh-токены, blacklist, кеш) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka (шина событий) ─────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_USER_EVENTS_TOPIC=nedovolen.user.events

# ── JWT (EdDSA / Ed25519) ────────────────────────────────────────────────────
# Приватный ключ знает только auth-сервис; публичный раздаётся клиентам.
# Генерация ключей — на этапе 3.
JWT_PRIVATE_KEY_PATH=./keys/ed25519_private.pem
JWT_PUBLIC_KEY_PATH=./keys/ed25519_public.pem
JWT_ISSUER=nedovolen
ACCESS_TOKEN_TTL_SECS=900          # 15 минут
REFRESH_TOKEN_TTL_SECS=1209600     # 14 дней

# ── Логирование ──────────────────────────────────────────────────────────────
# LOG_FORMAT: json | pretty
LOG_FORMAT=pretty
RUST_LOG=info,auth_service=debug
